        <mxCell id="cell_5" value="1. Chọn suất chiếu rạp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontFamily=Arial;shadow=1;" vertex="1" parent="1">
